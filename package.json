{
  "name": "crypto-lab-subverted-cipher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:maintenance && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "test:claims": "playwright test --project=claims",
    "test:maintenance": "node --test tests/maintenance-controls.node.mjs",
    "mutate": "node scripts/mutate.mjs",
    "test:mutation": "node scripts/mutate.mjs run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
